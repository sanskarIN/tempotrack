# TempoTrack runtime has no required secrets or network credentials.
# The variables below are build/release-only placeholders for optional local
# production Android signing. Never commit real values.

TEMPOTRACK_KEYSTORE_PATH=
TEMPOTRACK_KEYSTORE_PASSWORD=
TEMPOTRACK_KEY_ALIAS=
TEMPOTRACK_KEY_PASSWORD=

# GitHub Actions uses TEMPOTRACK_KEYSTORE_BASE64 as an encrypted repository or
# environment secret. It is intentionally omitted from local source examples
# because the workflow decodes it directly into RUNNER_TEMP.
